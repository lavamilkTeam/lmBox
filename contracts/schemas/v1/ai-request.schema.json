{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capability": {
      "enum": [
        "video",
        "agent"
      ]
    },
    "operation": {
      "enum": [
        "inspect",
        "start",
        "status",
        "cancel",
        "artifact"
      ]
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "requestId",
    "inputRevision",
    "capability",
    "operation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "status",
              "cancel",
              "artifact"
            ]
          }
        }
      },
      "then": {
        "required": [
          "jobId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "start",
              "artifact"
            ]
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "start"
          },
          "capability": {
            "const": "video"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "inputs": {
                          "type": "object",
                          "maxProperties": 512
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "inputs",
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 512,
                    "minItems": 1
                  }
                },
                "required": [
                  "nodes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "workflow"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "start"
          },
          "capability": {
            "const": "agent"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "maxSteps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 1048576
                    }
                  },
                  "required": [
                    "name",
                    "content"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 16
              },
              "parentJobId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            },
            "required": [
              "prompt",
              "maxSteps",
              "files"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "artifact"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "maxLength": 255
              }
            },
            "required": [
              "artifactId"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}

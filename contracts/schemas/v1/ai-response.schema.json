{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-response",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capability": {
      "enum": [
        "video",
        "agent"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "configured": {
              "type": "boolean"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "category": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "type": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "choices": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          },
                          "maxItems": 10000
                        },
                        "default": {},
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "required"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 512
                  },
                  "outputs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "type": {
                          "type": "string",
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 512
                  }
                },
                "required": [
                  "type",
                  "title",
                  "category",
                  "inputs",
                  "outputs"
                ],
                "additionalProperties": false
              },
              "maxItems": 10000
            }
          },
          "required": [
            "configured",
            "nodes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "configured": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "maxLength": 256
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256
              },
              "maxItems": 100
            }
          },
          "required": [
            "configured",
            "model",
            "tools"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "jobId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "capability": {
                  "enum": [
                    "video",
                    "agent"
                  ]
                },
                "inputRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "status": {
                  "enum": [
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "maxLength": 65536
                      }
                    },
                    "required": [
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1000
                },
                "result": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 1048576
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[^/\\\\\\x00-\\x1f:*?\"<>|]{1,255}$"
                          },
                          "name": {
                            "type": "string",
                            "pattern": "^[^/\\\\\\x00-\\x1f:*?\"<>|]{1,255}$"
                          },
                          "mimeType": {
                            "type": "string",
                            "maxLength": 128
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "mimeType"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 128
                    }
                  },
                  "required": [
                    "artifacts"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 65536
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "jobId",
                "capability",
                "inputRevision",
                "status",
                "events"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "job"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "mimeType": {
              "type": "string",
              "maxLength": 128
            },
            "base64": {
              "type": "string",
              "maxLength": 44739244
            }
          },
          "required": [
            "name",
            "mimeType",
            "base64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "requestId",
    "inputRevision",
    "capability",
    "ok"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEA request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "jobId",
    "inputRevision",
    "reactants",
    "calculation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "reactants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "species",
          "massFraction",
          "temperatureK"
        ],
        "properties": {
          "species": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[!-~]+$"
          },
          "massFraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "temperatureK": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "calculation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "temperatureK",
            "pressurePa"
          ],
          "properties": {
            "type": {
              "const": "tp"
            },
            "temperatureK": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pressurePa": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "pressurePa"
          ],
          "properties": {
            "type": {
              "const": "hp"
            },
            "pressurePa": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "chamberPressurePa",
            "exitAreaRatios",
            "chemistry"
          ],
          "properties": {
            "type": {
              "const": "rocket"
            },
            "chamberPressurePa": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "exitAreaRatios": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "number",
                "exclusiveMinimum": 1
              }
            },
            "chemistry": {
              "enum": [
                "equilibrium",
                "frozenAtChamber",
                "frozenAtThroat"
              ]
            }
          }
        }
      ]
    }
  }
}

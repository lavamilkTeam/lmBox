{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmbox.local/contracts/v1/cfd-request.schema.json",
  "title": "CFD session request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "requestId",
    "expectedRevision",
    "operation",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/$defs/id"
    },
    "requestId": {
      "$ref": "#/$defs/id"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "enum": [
        "initialize",
        "command",
        "inspect",
        "poll",
        "setField",
        "clickField",
        "editorAccept",
        "editorReject",
        "selectGeometry",
        "selectObject",
        "editObject",
        "deleteObject",
        "setVisibility",
        "undo",
        "redo",
        "setProperty",
        "importFile",
        "exportDocument",
        "dialogResponse",
        "close"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "maxItems": 100000
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "initialize",
              "inspect",
              "poll",
              "editorAccept",
              "editorReject",
              "undo",
              "redo",
              "exportDocument",
              "close"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "command"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commandId"
            ],
            "properties": {
              "commandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "childCommandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_]+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "setField"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fieldId",
              "value"
            ],
            "properties": {
              "fieldId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "value": {
                "$ref": "#/$defs/value"
              },
              "phase": {
                "enum": [
                  "input",
                  "commit"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "clickField"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fieldId"
            ],
            "properties": {
              "fieldId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "selectGeometry"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId",
              "subelements"
            ],
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "subelements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_]*$"
                },
                "maxItems": 10000
              },
              "append": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "editObject",
              "deleteObject"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId"
            ],
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "setVisibility"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId",
              "visible"
            ],
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "setProperty"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId",
              "name",
              "value"
            ],
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "value": {
                "$ref": "#/$defs/value"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "importFile"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "base64"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^(?!\\.)[^/\\\\:\\x00-\\x1f\\x7f]+\\.(?:[sS][tT][eE][pP]|[sS][tT][pP]|[iI][gG][eE][sS]|[iI][gG][sS]|[bB][rR][eE][pP]|[sS][tT][lL]|[oO][bB][jJ]|[fF][cC][sS][tT][dD])$"
              },
              "base64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 33554432,
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "dialogResponse"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dialogId",
              "buttonId"
            ],
            "properties": {
              "dialogId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "buttonId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "selectObject"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectId"
            ],
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "append": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ]
}

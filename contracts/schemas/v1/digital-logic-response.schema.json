{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "digital-logic-response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "requestId", "inputRevision", "tick", "outputs", "inputs", "displays", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "inputRevision": { "$ref": "#/$defs/counter" },
    "tick": { "$ref": "#/$defs/counter" },
    "outputs": { "type": "object", "maxProperties": 512, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/signal" } },
    "inputs": {
      "type": "object", "maxProperties": 512, "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "object", "maxProperties": 16, "propertyNames": { "type": "string", "pattern": "^[A-Za-z0-9_/-]{1,128}$" }, "additionalProperties": { "$ref": "#/$defs/signal" } }
    },
    "displays": { "type": "object", "maxProperties": 512, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/display" } },
    "diagnostics": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "signal": { "enum": ["0", "1", "X", "Z"] },
    "display": {
      "type": "object", "additionalProperties": false, "required": ["rows", "cursor", "displayOn"],
      "properties": {
        "rows": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 16, "maxLength": 16 } },
        "cursor": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 31 }] },
        "displayOn": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["message"],
      "properties": { "nodeId": { "$ref": "#/$defs/id" }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    }
  }
}

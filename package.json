{
  "name": "stencil-studio",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:installer": "vite --config vite.installer.config.ts",
    "build:installer": "vue-tsc --noEmit && vite build --config vite.installer.config.ts",
    "installer:build": "node scripts/installer.mjs build",
    "installer:dev": "node scripts/installer.mjs dev",
    "installer:package": "node scripts/installer.mjs package",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint:boundaries": "depcruise frontend --config .dependency-cruiser.cjs",
    "check": "npm run lint:boundaries && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "setup:wasm": "rustup target add wasm32-unknown-unknown && cargo install wasm-bindgen-cli --version 0.2.129 --locked --root .tools/wasm-bindgen",
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm && npm run build:preview && npm run build:cfd",
    "prebuild": "npm run build:wasm",
    "precheck": "npm run build:wasm && npm run build:preview && npm run build:cfd",
    "setup:cfd": "node scripts/setup-cfd.mjs",
    "build:cfd": "cargo build --manifest-path src-rust/Cargo.toml --bin cfd --locked",
    "setup:geometry": "node scripts/geometry-env.mjs setup",
    "build:preview": "cargo build --manifest-path src-rust/Cargo.toml --bin preview --locked",
    "check:geometry": "node scripts/geometry-env.mjs check",
    "dev:desktop": "vite --host 127.0.0.1 --port 6522",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "build:backend": "npm run build:cea && npm run build:propulsion && cargo build --manifest-path src-rust/Cargo.toml --locked --bins",
    "build:cea": "node scripts/build-cea.mjs",
    "check:cea": "cargo test --manifest-path src-rust/Cargo.toml --locked --features cea-integration --test cea_native",
    "build:worker": "node scripts/build-worker.mjs",
    "check:worker": "node scripts/check-worker.mjs",
    "build:propulsion": "node scripts/build-propulsion.mjs",
    "check:propulsion": "cargo test --manifest-path src-rust/Cargo.toml --locked --features cea-integration --test propulsion_native"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@tauri-apps/api": "^2.12.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "dependency-cruiser": "^18.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "license": "SEE LICENSE IN LICENSE"
}

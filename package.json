{
  "name": "stencil-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run lint:boundaries && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "setup:wasm": "rustup target add wasm32-unknown-unknown && cargo install wasm-bindgen-cli --version 0.2.129 --locked --root .tools/wasm-bindgen",
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "precheck": "npm run build:wasm"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "fflate": "^0.8.3",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "dependency-cruiser": "^18.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "license": "SEE LICENSE IN LICENSE"
}

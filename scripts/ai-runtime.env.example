# Copy to .tools/ai/runtime.env for local development; keep actual credentials out of Git.
# Local ComfyUI orchestrates nodes; cloud Partner/API nodes perform model inference.
LMBOX_COMFYUI_URL=http://127.0.0.1:8188
LMBOX_COMFYUI_API_KEY=
LMBOX_COMFY_PARTNER_API_KEY=
# Custom node credentials require ComfyUI to run with --disable-metadata.
LMBOX_COMFY_NODE_CREDENTIALS={}

# Compatible Chat Completions provider for the working assistant.
LMBOX_AGENT_BASE_URL=https://api.openai.com/v1
LMBOX_AGENT_MODEL=
LMBOX_AGENT_API_KEY=

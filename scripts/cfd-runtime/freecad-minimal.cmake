# CfdOF uses the native FreeCAD GUI controllers even when its window is hidden.
# Workbench selection follows the imports in the CFD adapter and CfdOF.
set(BUILD_GUI ON CACHE BOOL "" FORCE)
foreach(module IN ITEMS MATERIAL PART MESH MESH_PART FEM PLOT)
    set(BUILD_${module} ON CACHE BOOL "" FORCE)
endforeach()
foreach(module IN ITEMS
        ADDONMGR ASSEMBLY BIM CAM CLOUD DESIGNER_PLUGIN DRAFT DRAWING
        FEM_NETGEN FLAT_MESH HELP IDF IMPORT INSPECTION JTREADER
        MATERIAL_EXTERNAL MEASURE OPENSCAD PART_DESIGN POINTS
        REVERSEENGINEERING ROBOT SANDBOX SHOW SKETCHER SPREADSHEET
        START SURFACE TECHDRAW TEMPLATE TEST TUX VR WEB)
    set(BUILD_${module} OFF CACHE BOOL "" FORCE)
endforeach()
set(BUILD_WITH_CONDA ON CACHE BOOL "" FORCE)
set(FREECAD_QT_MAJOR_VERSION 6 CACHE STRING "" FORCE)
set(FREECAD_USE_3DCONNEXION_LEGACY OFF CACHE BOOL "" FORCE)
set(FREECAD_USE_3DCONNEXION_NAVLIB OFF CACHE BOOL "" FORCE)
set(FREECAD_3DCONNEXION_SUPPORT None CACHE STRING "" FORCE)
set(FREECAD_USE_PCL OFF CACHE BOOL "" FORCE)
set(FREECAD_USE_EXTERNAL_SMESH OFF CACHE BOOL "" FORCE)
set(FREECAD_CREATE_MAC_APP OFF CACHE BOOL "" FORCE)
set(INSTALL_TO_SITEPACKAGES OFF CACHE BOOL "" FORCE)
set(INSTALL_PREFER_SYMLINKS OFF CACHE BOOL "" FORCE)
set(ENABLE_DEVELOPER_TESTS OFF CACHE BOOL "" FORCE)
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
set(CMAKE_INSTALL_BINDIR bin CACHE PATH "" FORCE)
set(CMAKE_INSTALL_LIBDIR lib CACHE PATH "" FORCE)
set(CMAKE_INSTALL_DATADIR . CACHE PATH "" FORCE)
set(CMAKE_INSTALL_DOCDIR share/doc/freecad CACHE PATH "" FORCE)
set(CMAKE_INSTALL_RPATH "@loader_path;@loader_path/../lib" CACHE STRING "" FORCE)
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH OFF CACHE BOOL "" FORCE)

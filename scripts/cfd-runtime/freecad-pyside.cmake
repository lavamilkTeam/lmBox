# Build the upstream support library without generating or rebuilding bindings.
cmake_minimum_required(VERSION 3.18)
project(lmbox_pyside_patch LANGUAGES CXX)

if(NOT LMBOX_PYSIDE_SOURCE)
    message(FATAL_ERROR "LMBOX_PYSIDE_SOURCE must name the verified PySide source")
endif()
set(FORCE_LIMITED_API OFF CACHE BOOL "" FORCE)
find_package(Shiboken6 6.8.3 EXACT CONFIG REQUIRED)
find_package(Qt6 6.8.3 EXACT REQUIRED COMPONENTS Core)
include("${LMBOX_PYSIDE_SOURCE}/sources/pyside6/cmake/Macros/PySideModules.cmake")
include("${LMBOX_PYSIDE_SOURCE}/sources/pyside6/.cmake.conf")
set_cmake_cxx_flags()
set(BINDING_NAME PySide6)
set(BINDING_API_VERSION 6.8.3)
set(BINDING_API_VERSION_FULL 6.8.3)
set(PYSIDE_SO_VERSION 6.8)
set(PYSIDE_QT_VERSION 6.8)
set(LIB_INSTALL_DIR lib)
set(pysidebindings_SOURCE_DIR "${LMBOX_PYSIDE_SOURCE}/sources/pyside6")
set(pysidebindings_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}")
set(PYTHON_SITE_PACKAGES "${CMAKE_INSTALL_PREFIX}/lib/python3.11/site-packages")
add_subdirectory("${pysidebindings_SOURCE_DIR}/libpyside" libpyside)

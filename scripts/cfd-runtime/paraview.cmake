# Build only the VTK reader/filter closure from ParaView's pinned VTK source.
set(CMAKE_BUILD_TYPE MinSizeRel CACHE STRING "")
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET 13.0 CACHE STRING "")
set(CMAKE_INSTALL_RPATH "@loader_path;@loader_path/../lib" CACHE STRING "")
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH OFF CACHE BOOL "")
set(BUILD_SHARED_LIBS ON CACHE BOOL "")
set(VTK_BUILD_ALL_MODULES OFF CACHE BOOL "")
set(VTK_BUILD_TESTING OFF CACHE STRING "")
set(VTK_BUILD_DOCUMENTATION OFF CACHE BOOL "")
set(VTK_BUILD_EXAMPLES OFF CACHE BOOL "")
set(VTK_INSTALL_SDK OFF CACHE BOOL "")
set(VTK_WRAP_PYTHON ON CACHE BOOL "")
set(VTK_BUILD_PYI_FILES OFF CACHE BOOL "")
set(VTK_USE_MPI OFF CACHE BOOL "")
set(VTK_USE_CUDA OFF CACHE BOOL "")
set(VTK_ENABLE_CATALYST OFF CACHE BOOL "")
set(VTK_FORBID_DOWNLOADS ON CACHE BOOL "")
set(VTK_GROUP_ENABLE_StandAlone DONT_WANT CACHE STRING "")
set(VTK_GROUP_ENABLE_Rendering DONT_WANT CACHE STRING "")
set(VTK_GROUP_ENABLE_Qt NO CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_RenderingOpenGL2 NO CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_CommonCore YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_CommonDataModel YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_FiltersCore YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_FiltersFlowPaths YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_FiltersGeometry YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_FiltersExtraction YES CACHE STRING "")
set(VTK_MODULE_ENABLE_VTK_IOParallel YES CACHE STRING "")

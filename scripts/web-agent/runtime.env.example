# Run on the OS/architecture recorded in build.json with Node.js 24+.
# node --env-file=/private/path/runtime.env server/server.mjs
HOST=127.0.0.1
PORT=3102
LMBOX_WEB_ORIGIN=https://agent.example.com
LMBOX_WEB_USERNAME=operator
LMBOX_WEB_PASSWORD=
LMBOX_WEB_DATA=/var/lib/lmbox-agent
# Optional cloud mode. Set all three; work then runs only in the ensured container.
LMBOX_CONTAINER_ENSURE_URL=https://manage.example.com/api/containers/v1/ensure
LMBOX_CONTAINER_SERVICE_TOKEN=
LMBOX_CLOUD_USER_ID=
# Local mode only. Cloud containers receive a scoped runtime credential instead.
LMBOX_AGENT_BASE_URL=https://manage.example.com/api/model-gateway/v1
LMBOX_AGENT_MODEL=default-agent
LMBOX_AGENT_API_KEY=
LMBOX_AGENT_TIMEOUT_MS=200000
# Optional; omit unless supported by the configured upstream.
# LMBOX_AGENT_REASONING_EFFORT=medium
